{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "polling_access": {
      "()": "sglang_omni.utils.logging.PollingAccessFilter"
    }
  },
  "formatters": {
    "detail": {
      "()": "sglang_omni.utils.logging.DebugLogFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "detail",
      "stream": "ext://sys.stderr"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": [], "propagate": true},
    "uvicorn.error": {"handlers": [], "propagate": true},
    "uvicorn.access": {"handlers": [], "propagate": true, "filters": ["polling_access"]}
  },
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  }
}

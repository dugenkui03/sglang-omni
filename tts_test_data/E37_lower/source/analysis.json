      "cet_meaning_zh": "或许，大概",
      "phonetic": "/ˈprɑːbəbli/",
      "original_sentence": "I was probably worrying too much.",
      "simple_sentence": "She is probably at home.",
      "explanation_zh": "probably 的意思是大概或许。原句是 I was probably worrying too much。简单例句是 She is probably at home。"
    },
    {
      "id": "vocab_0001",
      "word": "apart",
      "norm_word": "apart",
      "dialogue_index": 8,
      "source": "asr_9",
      "speaker": "安陵容",
      "start_ms": 16950,
      "end_ms": 18590,
      "meaning_zh": "分开",
      "cet_meaning_zh": "相隔；分开；除去",
      "phonetic": "/əˈpɑːrt/",
      "original_sentence": "I thought we had grown apart.",
      "simple_sentence": "They sat far apart.",
      "explanation_zh": "apart 的意思是分开。原句是 I thought we had grown apart。简单例句是 They sat far apart。"
    }
  ]
}
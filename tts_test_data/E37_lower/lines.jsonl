{"line_id": "E37_lower_0034", "unit_id": "E37_lower", "line_index": 34, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "才惹姐姐生气。", "text_en": "that upset you.", "text_en_tts": "that upset you", "start_ms": 76120, "end_ms": 77200, "audio_path": "E37_lower/audio/安陵容/line_0034.wav", "audio_sha256": "72fbb1689bb2bc0a9f520a38b223e71fe0273e9b8f1152f478d8fc48ce6ac0a4", "reference_duration_ms": 1080.0, "reference_start_ms": 76120, "reference_end_ms": 77200, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 34}
{"line_id": "E37_lower_0035", "unit_id": "E37_lower", "line_index": 35, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "不必了，", "text_en": "That is enough.", "text_en_tts": "Enough", "start_ms": 77920, "end_ms": 78560, "audio_path": "E37_lower/audio/沈眉庄/line_0035.wav", "audio_sha256": "20ad69d97b99c119e7d9b9cebc733d5e29d1fa68f7890d5226f8c06010e4713b", "reference_duration_ms": 640.0, "reference_start_ms": 77920, "reference_end_ms": 78560, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 35}
{"line_id": "E37_lower_0036", "unit_id": "E37_lower", "line_index": 36, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "你有这个工夫和我解释，", "text_en": "You have time to explain to me,", "text_en_tts": "You have time to explain to me,", "start_ms": 79080, "end_ms": 80960, "audio_path": "E37_lower/audio/沈眉庄/line_0036.wav", "audio_sha256": "3343fea5577bc3dda1401f6db9b2b2aa2a1bd26b1127065e5c6b8773ceb35e19", "reference_duration_ms": 1880.0, "reference_start_ms": 79080, "reference_end_ms": 80960, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 36}
{"line_id": "E37_lower_0037", "unit_id": "E37_lower", "line_index": 37, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "还不如留着力气去讨好皇上。", "text_en": "you might as well use that energy to please the Emperor", "text_en_tts": "Save your energy for the Emperor", "start_ms": 81440, "end_ms": 83480, "audio_path": "E37_lower/audio/沈眉庄/line_0037.wav", "audio_sha256": "6b00e73afca1ccc33fbf7521c27b51642650e82d1fddf70772f3a9d882793932", "reference_duration_ms": 2040.0, "reference_start_ms": 81440, "reference_end_ms": 83480, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 37}
{"line_id": "E37_lower_0038", "unit_id": "E37_lower", "line_index": 38, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "力劝皇上惩治华妃。", "text_en": "and urge him to punish Hua.", "text_en_tts": "and urge him to punish Hua", "start_ms": 84090, "end_ms": 85930, "audio_path": "E37_lower/audio/沈眉庄/line_0038.wav", "audio_sha256": "f8e837fe42eae99a93468bcb9fbdccdeaddaf003a37076ed3875b7fac1eb5e51", "reference_duration_ms": 1840.0, "reference_start_ms": 84090, "reference_end_ms": 85930, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 38}
{"line_id": "E37_lower_0039", "unit_id": "E37_lower", "line_index": 39, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "都是妹妹无能。", "text_en": "I am just useless.", "text_en_tts": "I am just useless", "start_ms": 87440, "end_ms": 88320, "audio_path": "E37_lower/audio/安陵容/line_0039.wav", "audio_sha256": "3620cad2d4abecde058b0f8815ae9cd6234d58438ec3f42bf3d4c3169fc3299e", "reference_duration_ms": 880.0, "reference_start_ms": 87440, "reference_end_ms": 88320, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 39}
{"line_id": "E37_lower_0040", "unit_id": "E37_lower", "line_index": 40, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "无能是小，", "text_en": "Being useless is not a big deal,", "text_en_tts": "Useless is nothing,", "start_ms": 88760, "end_ms": 89680, "audio_path": "E37_lower/audio/沈眉庄/line_0040.wav", "audio_sha256": "bb83ee8752cfd644e6c867ab4f45679e80a1f649e9344fcf17c9c8024e5a46be", "reference_duration_ms": 920.0, "reference_start_ms": 88760, "reference_end_ms": 89680, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 40}
{"line_id": "E37_lower_0041", "unit_id": "E37_lower", "line_index": 41, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "若是心术不正，", "text_en": "but having bad intentions,", "text_en_tts": "but having bad intentions,", "start_ms": 90160, "end_ms": 91360, "audio_path": "E37_lower/audio/沈眉庄/line_0041.wav", "audio_sha256": "6df5ee5b8327b3b0344ba78b8f610f2a24476427384e00184afd240403e2e3f7", "reference_duration_ms": 1200.0, "reference_start_ms": 90160, "reference_end_ms": 91360, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 41}

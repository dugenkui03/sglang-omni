{"line_id": "E37_lower_0023", "unit_id": "E37_lower", "line_index": 23, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "便不会借宝鹃的嘴说与我听。", "text_en": "you would not have used Baojuan to tell me.", "text_en_tts": "you never would have asked Baojuan to say it for you", "start_ms": 49770, "end_ms": 52130, "audio_path": "E37_lower/audio/沈眉庄/line_0023.wav", "audio_sha256": "23cef023232ae393aca41f43266c6934a2129cf6422979c6d3bc7eb534009217", "reference_duration_ms": 2360.0, "reference_start_ms": 49770, "reference_end_ms": 52130, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 23}
{"line_id": "E37_lower_0024", "unit_id": "E37_lower", "line_index": 24, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "莞嫔行事不正。", "text_en": "Wan acted improperly.", "text_en_tts": "Wan acted improperly", "start_ms": 52850, "end_ms": 54090, "audio_path": "E37_lower/audio/沈眉庄/line_0024.wav", "audio_sha256": "b48d7f42bfe56500c37637875b7bb0bf8ac87eab3d76ea4cfac8139b04bd412c", "reference_duration_ms": 1240.0, "reference_start_ms": 52850, "reference_end_ms": 54090, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 24}
{"line_id": "E37_lower_0025", "unit_id": "E37_lower", "line_index": 25, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "你也未必坦坦荡荡。", "text_en": "You are not innocent either.", "text_en_tts": "You are not innocent either", "start_ms": 54940, "end_ms": 56420, "audio_path": "E37_lower/audio/沈眉庄/line_0025.wav", "audio_sha256": "2b8cf7f4fd0000cd1118d05f0b044a9ca175d8e307b6a5a4090a63c49ba6d84f", "reference_duration_ms": 1480.0, "reference_start_ms": 54940, "reference_end_ms": 56420, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 25}
{"line_id": "E37_lower_0026", "unit_id": "E37_lower", "line_index": 26, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "姐姐说这话，便是错怪妹妹了。", "text_en": "You are blaming me unfairly.", "text_en_tts": "You are not being fair to me by saying that", "start_ms": 57700, "end_ms": 59940, "audio_path": "E37_lower/audio/安陵容/line_0026.wav", "audio_sha256": "19dbdfa5f1a411f9edd489d12ebe32e6f960879b0e0881fd63f98f1743a6100b", "reference_duration_ms": 2240.0, "reference_start_ms": 57700, "reference_end_ms": 59940, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 26}
{"line_id": "E37_lower_0027", "unit_id": "E37_lower", "line_index": 27, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "我与姐姐同仇敌忾，", "text_en": "We share the same enemy,", "text_en_tts": "You and I share the same enemy", "start_ms": 60460, "end_ms": 61980, "audio_path": "E37_lower/audio/安陵容/line_0027.wav", "audio_sha256": "82c82d43ff873b037f98bd854c8c9364af6d04c1d9073d71f312c80a37c67feb", "reference_duration_ms": 1520.0, "reference_start_ms": 60460, "reference_end_ms": 61980, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 27}
{"line_id": "E37_lower_0028", "unit_id": "E37_lower", "line_index": 28, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "厌憎华妃，", "text_en": "we detest Hua,", "text_en_tts": "we detest Hua,", "start_ms": 62460, "end_ms": 63220, "audio_path": "E37_lower/audio/安陵容/line_0028.wav", "audio_sha256": "6187288b9c15debbe17f8c3868f1038e52a3733f3603d46a6cf86a1ffdf02ad9", "reference_duration_ms": 760.0, "reference_start_ms": 62460, "reference_end_ms": 63220, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 28}
{"line_id": "E37_lower_0029", "unit_id": "E37_lower", "line_index": 29, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "才会担心莞姐姐一时糊涂。", "text_en": "that is why I worried Wan was making a mistake.", "text_en_tts": "that is why I worried Wan was making a mistake", "start_ms": 63820, "end_ms": 66020, "audio_path": "E37_lower/audio/安陵容/line_0029.wav", "audio_sha256": "a862038e09ddb919c06a29fb3cbfc50f8c6b23ea510fd8eaa72fd2949c2086a2", "reference_duration_ms": 2200.0, "reference_start_ms": 63820, "reference_end_ms": 66020, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 29}
{"line_id": "E37_lower_0030", "unit_id": "E37_lower", "line_index": 30, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "你若担心她糊涂，", "text_en": "If you were worried she was being foolish,", "text_en_tts": "If you think she is wrong,", "start_ms": 66550, "end_ms": 67710, "audio_path": "E37_lower/audio/沈眉庄/line_0030.wav", "audio_sha256": "a511b78855d7b801dd454c49ed63e40bd27bf5cdabfa914b4e5680134f8e3b0d", "reference_duration_ms": 1160.0, "reference_start_ms": 66550, "reference_end_ms": 67710, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 30}
{"line_id": "E37_lower_0031", "unit_id": "E37_lower", "line_index": 31, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "说与她自己知道就是。", "text_en": "you should tell her yourself.", "text_en_tts": "you should tell her yourself", "start_ms": 68230, "end_ms": 69870, "audio_path": "E37_lower/audio/沈眉庄/line_0031.wav", "audio_sha256": "e75b3d9865f420410be2106bd1d8d2c845ccab7a09aeb6a30f55d3129015b28d", "reference_duration_ms": 1640.0, "reference_start_ms": 68230, "reference_end_ms": 69870, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 31}
{"line_id": "E37_lower_0032", "unit_id": "E37_lower", "line_index": 32, "speaker": "安陵容", "speaker_id": "E37_lower:char_001", "text_zh": "姐姐别生气，", "text_en": "Please do not be angry.", "text_en_tts": "Please do not be angry", "start_ms": 72480, "end_ms": 73320, "audio_path": "E37_lower/audio/安陵容/line_0032.wav", "audio_sha256": "34832f2f23e7410a626476121d1567f598b9eb1feb1b9ddb04308140129cddc0", "reference_duration_ms": 840.0, "reference_start_ms": 72480, "reference_end_ms": 73320, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 32}

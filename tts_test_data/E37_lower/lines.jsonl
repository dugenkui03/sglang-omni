{"line_id": "E37_lower_0051", "unit_id": "E37_lower", "line_index": 51, "speaker": "沈眉庄", "speaker_id": "E37_lower:char_002", "text_zh": "自己说给她知道便是了，", "text_en": "tell her yourself,", "text_en_tts": "tell her yourself,", "start_ms": 111700, "end_ms": 113460, "audio_path": "E37_lower/audio/沈眉庄/line_0051.wav", "audio_sha256": "e8c556ff55a1a5bcc83e790bb6de86154fcd2ee8ad33f73a5487fa2650e93cb0", "reference_duration_ms": 1760.0, "reference_start_ms": 111700, "reference_end_ms": 113460, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 51}

{"line_id": "E37_upper_0000", "unit_id": "E37_upper", "line_index": 0, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "姐姐宫里怎么连个人影都没有？", "text_en": "Why is there no one here, sister?", "text_en_tts": "Why is there no one here, sister?", "start_ms": 40, "end_ms": 2200, "audio_path": "E37_upper/audio/甄嬛/line_0000.wav", "audio_sha256": "35777ce60d2cb8fca6328b7a88b6c0346cfce78ccedfad5f85c7c6f9e207cdbc", "reference_duration_ms": 2160.0, "reference_start_ms": 40, "reference_end_ms": 2200, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 0}
{"line_id": "E37_upper_0001", "unit_id": "E37_upper", "line_index": 1, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "那些奴才呢？", "text_en": "Where are the servants?", "text_en_tts": "Where are the servants?", "start_ms": 3810, "end_ms": 4690, "audio_path": "E37_upper/audio/甄嬛/line_0001.wav", "audio_sha256": "8dc5ee537d676f393e5921a1d3f2b977e2705be79caced1786fda9a0fa87ffa2", "reference_duration_ms": 880.0, "reference_start_ms": 3810, "reference_end_ms": 4690, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 1}
{"line_id": "E37_upper_0002", "unit_id": "E37_upper", "line_index": 2, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "怎么不伺候着？", "text_en": "Why are they not serving you?", "text_en_tts": "Why are they not serving you?", "start_ms": 5050, "end_ms": 6090, "audio_path": "E37_upper/audio/甄嬛/line_0002.wav", "audio_sha256": "213aecde4023e825d83456e66fdfaf43c0ba832ccc22eee39c7303949ba79105", "reference_duration_ms": 1040.0, "reference_start_ms": 5050, "reference_end_ms": 6090, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 2}
{"line_id": "E37_upper_0003", "unit_id": "E37_upper", "line_index": 3, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "今儿是宫中发放夏衣的日子，", "text_en": "Today the palace gives out summer clothes.", "text_en_tts": "Today the palace gives out summer clothes", "start_ms": 8230, "end_ms": 10230, "audio_path": "E37_upper/audio/沈眉庄/line_0003.wav", "audio_sha256": "bbfbdceabbba8a646c3b2067096a698177227a142673c3b5ba987c6b4d9e6869", "reference_duration_ms": 2000.0, "reference_start_ms": 8230, "reference_end_ms": 10230, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 3}
{"line_id": "E37_upper_0004", "unit_id": "E37_upper", "line_index": 4, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "我让他们去内务府领了。", "text_en": "I sent them to the office to get them.", "text_en_tts": "I sent them to the office to get them", "start_ms": 10630, "end_ms": 12470, "audio_path": "E37_upper/audio/沈眉庄/line_0004.wav", "audio_sha256": "8680b097b93a8304c9b16a51354b2c3a785ee5b3302043e01d7c7438a81633dd", "reference_duration_ms": 1840.0, "reference_start_ms": 10630, "reference_end_ms": 12470, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 4}
{"line_id": "E37_upper_0005", "unit_id": "E37_upper", "line_index": 5, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "比不得你宫里家大业大，", "text_en": "Not like your place, so grand and busy.", "text_en_tts": "Not like your place, so grand and busy", "start_ms": 13780, "end_ms": 16020, "audio_path": "E37_upper/audio/沈眉庄/line_0005.wav", "audio_sha256": "adfbc24dac36c9b5ff5dd82b01d2a3c5d949577945619ef967801f810766957a", "reference_duration_ms": 2240.0, "reference_start_ms": 13780, "reference_end_ms": 16020, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 5}

{"line_id": "E37_upper_0013", "unit_id": "E37_upper", "line_index": 13, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "好，", "text_en": "Fine.", "text_en_tts": "Fine", "start_ms": 41330, "end_ms": 41650, "audio_path": "E37_upper/audio/沈眉庄/line_0013.wav", "audio_sha256": "c51e3f13b196588234e32087ab26cec2857772207e1b4e705e0a9ccc1a061de4", "reference_duration_ms": 500.0, "reference_start_ms": 41240, "reference_end_ms": 41740, "reference_window_source": "Existing workflow.log expansion entry", "reference_text_needs_review": true, "reference_text_review_reason": "The source workflow expanded a short reference window to 500 ms; adjacent speech may not be covered by text_zh.", "source_dialogue_index": 13}
{"line_id": "E37_upper_0014", "unit_id": "E37_upper", "line_index": 14, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "那我问你，", "text_en": "Then I ask you,", "text_en_tts": "Then I ask you,", "start_ms": 42210, "end_ms": 43090, "audio_path": "E37_upper/audio/沈眉庄/line_0014.wav", "audio_sha256": "82d47a12023a6a8020c72a7866d3df71b71650fb2f6d54ad589b7cdf60441f0c", "reference_duration_ms": 880.0, "reference_start_ms": 42210, "reference_end_ms": 43090, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 14}
{"line_id": "E37_upper_0015", "unit_id": "E37_upper", "line_index": 15, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "华妃复位之事，是不是你向皇上提议？", "text_en": "Did you suggest to the Emperor to restore Hua Fei?", "text_en_tts": "Was it you who suggested to the Emperor to restore Hua Fei?", "start_ms": 43650, "end_ms": 46610, "audio_path": "E37_upper/audio/沈眉庄/line_0015.wav", "audio_sha256": "6c42e788455874e36c1ab4ba48387b77dccca1ce60d7da8dba43af67c9e2bcaf", "reference_duration_ms": 2960.0, "reference_start_ms": 43650, "reference_end_ms": 46610, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 15}
{"line_id": "E37_upper_0016", "unit_id": "E37_upper", "line_index": 16, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "是。", "text_en": "Yes.", "text_en_tts": "Yes", "start_ms": 47410, "end_ms": 47770, "audio_path": "E37_upper/audio/甄嬛/line_0016.wav", "audio_sha256": "c3b405c540a1a67ae0bec2293bba5cd9215cb35f1d5747a4218f18dcab31abb0", "reference_duration_ms": 500.0, "reference_start_ms": 47340, "reference_end_ms": 47840, "reference_window_source": "Existing workflow.log expansion entry", "reference_text_needs_review": true, "reference_text_review_reason": "The source workflow expanded a short reference window to 500 ms; adjacent speech may not be covered by text_zh.", "source_dialogue_index": 16}
{"line_id": "E37_upper_0017", "unit_id": "E37_upper", "line_index": 17, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "可是姐姐，", "text_en": "But sister,", "text_en_tts": "But sister,", "start_ms": 49110, "end_ms": 49790, "audio_path": "E37_upper/audio/甄嬛/line_0017.wav", "audio_sha256": "fb4ca156a1aed0dcadb7f58b65d1b5055a9c56e9eb0640089b57d82c482e3495", "reference_duration_ms": 680.0, "reference_start_ms": 49110, "reference_end_ms": 49790, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 17}
{"line_id": "E37_upper_0018", "unit_id": "E37_upper", "line_index": 18, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "我也是不得已。", "text_en": "I had no choice.", "text_en_tts": "I had no choice", "start_ms": 50470, "end_ms": 51550, "audio_path": "E37_upper/audio/甄嬛/line_0018.wav", "audio_sha256": "6a5f2d73b90336ee3367cff3ea02ec06cbdb45c3bf443a0afd6c74b998b40871", "reference_duration_ms": 1080.0, "reference_start_ms": 50470, "reference_end_ms": 51550, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 18}
{"line_id": "E37_upper_0019", "unit_id": "E37_upper", "line_index": 19, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "谁愿意捧了杀了自己孩子的仇敌上位？", "text_en": "Who would want to elevate the enemy who killed my child?", "text_en_tts": "Who would want to elevate the enemy who killed my child?", "start_ms": 52670, "end_ms": 55030, "audio_path": "E37_upper/audio/甄嬛/line_0019.wav", "audio_sha256": "a5d9f17b47321796f287e2010b95718076464f584068616b9e7a13a418a1bdca", "reference_duration_ms": 2360.0, "reference_start_ms": 52670, "reference_end_ms": 55030, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 19}
{"line_id": "E37_upper_0020", "unit_id": "E37_upper", "line_index": 20, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "也请姐姐为我想一想，", "text_en": "Please think for me, sister.", "text_en_tts": "Please think for me, sister", "start_ms": 56110, "end_ms": 57630, "audio_path": "E37_upper/audio/甄嬛/line_0020.wav", "audio_sha256": "447ea9d8daaa51ad8f2e5f989b5118721bbbbe419b6c6c55102cd4adf601b53f", "reference_duration_ms": 1520.0, "reference_start_ms": 56110, "reference_end_ms": 57630, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 20}
{"line_id": "E37_upper_0021", "unit_id": "E37_upper", "line_index": 21, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "若不是情非得已，", "text_en": "If I were not forced,", "text_en_tts": "If I had no other choice", "start_ms": 58550, "end_ms": 59790, "audio_path": "E37_upper/audio/甄嬛/line_0021.wav", "audio_sha256": "7c08b6552dc2368c5ed4bf5b2e8b705806b4f66a7285a114be1a3ac22de36055", "reference_duration_ms": 1240.0, "reference_start_ms": 58550, "reference_end_ms": 59790, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 21}
{"line_id": "E37_upper_0022", "unit_id": "E37_upper", "line_index": 22, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "我何必走这一遭？", "text_en": "why would I do this?", "text_en_tts": "why would I do this?", "start_ms": 60510, "end_ms": 61590, "audio_path": "E37_upper/audio/甄嬛/line_0022.wav", "audio_sha256": "7d830b1071a2b441145ff4069ef96eab4a9aefadee01f2a82dc22e5468a12f73", "reference_duration_ms": 1080.0, "reference_start_ms": 60510, "reference_end_ms": 61590, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 22}
{"line_id": "E37_upper_0023", "unit_id": "E37_upper", "line_index": 23, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "姐姐不能容忍的，", "text_en": "What you cannot bear,", "text_en_tts": "What you cannot bear,", "start_ms": 63120, "end_ms": 64240, "audio_path": "E37_upper/audio/甄嬛/line_0023.wav", "audio_sha256": "013f7a06ea96ecd459372395c92dfb71b30934caf8ab75e9a724298533b40aa6", "reference_duration_ms": 1120.0, "reference_start_ms": 63120, "reference_end_ms": 64240, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 23}
{"line_id": "E37_upper_0024", "unit_id": "E37_upper", "line_index": 24, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "妹妹我身受之苦并不亚于姐姐，", "text_en": "my suffering is no less [painful] than yours.", "text_en_tts": "my suffering is no less painful than yours", "start_ms": 64720, "end_ms": 67240, "audio_path": "E37_upper/audio/甄嬛/line_0024.wav", "audio_sha256": "3bb271b956dae128cb3e93a96b9f02c04951ab7dc657105227dd8a1a4f2b6d91", "reference_duration_ms": 2520.0, "reference_start_ms": 64720, "reference_end_ms": 67240, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 24}
{"line_id": "E37_upper_0025", "unit_id": "E37_upper", "line_index": 25, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "难道可以容忍吗？", "text_en": "Do you think I can bear it?", "text_en_tts": "Do you think I can bear it?", "start_ms": 68160, "end_ms": 69440, "audio_path": "E37_upper/audio/甄嬛/line_0025.wav", "audio_sha256": "45a1a69458961652b034e26926a599acea6234f60ec900c0795399d161f20a53", "reference_duration_ms": 1280.0, "reference_start_ms": 68160, "reference_end_ms": 69440, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 25}

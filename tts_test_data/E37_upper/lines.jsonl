{"line_id": "E37_upper_0008", "unit_id": "E37_upper", "line_index": 8, "speaker": "沈眉庄", "speaker_id": "E37_upper:char_002", "text_zh": "都亲自上门送奴才们的衣裳。", "text_en": "came personally to deliver the servants' clothes.", "text_en_tts": "came to deliver the servants' clothes himself", "start_ms": 20660, "end_ms": 22700, "audio_path": "E37_upper/audio/沈眉庄/line_0008.wav", "audio_sha256": "773cb7952a904f61a8a0214567f0424bdbff36d0cdf235ee4984fd40cf07976a", "reference_duration_ms": 2040.0, "reference_start_ms": 20660, "reference_end_ms": 22700, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 8}
{"line_id": "E37_upper_0009", "unit_id": "E37_upper", "line_index": 9, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "我知道，", "text_en": "I know.", "text_en_tts": "I know", "start_ms": 24330, "end_ms": 24930, "audio_path": "E37_upper/audio/甄嬛/line_0009.wav", "audio_sha256": "144d75bd43a3452033b65607cf867ba4fed2b737fec1cd98ccd57168800926a7", "reference_duration_ms": 600.0, "reference_start_ms": 24330, "reference_end_ms": 24930, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 9}
{"line_id": "E37_upper_0010", "unit_id": "E37_upper", "line_index": 10, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "姐姐不是在意皇上的宠幸。", "text_en": "You are not concerned about the Emperor's favor.", "text_en_tts": "You are not concerned about the Emperor's favor", "start_ms": 26090, "end_ms": 28130, "audio_path": "E37_upper/audio/甄嬛/line_0010.wav", "audio_sha256": "4c4ffa65ee4e10bdf4bf6ad0b928eb351a915edc792e03ba5d3015e4ad659825", "reference_duration_ms": 2040.0, "reference_start_ms": 26090, "reference_end_ms": 28130, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 10}
{"line_id": "E37_upper_0011", "unit_id": "E37_upper", "line_index": 11, "speaker": "甄嬛", "speaker_id": "E37_upper:char_001", "text_zh": "姐姐这样说，", "text_en": "You say this,", "text_en_tts": "You say this,", "start_ms": 31520, "end_ms": 32440, "audio_path": "E37_upper/audio/甄嬛/line_0011.wav", "audio_sha256": "34250597c31da9f51e53e81c80253f54b1b6a66e0dd1b0d7b185df34d6038664", "reference_duration_ms": 920.0, "reference_start_ms": 31520, "reference_end_ms": 32440, "reference_window_source": "Source dialogue timestamps; verified against WAV frame count", "reference_text_needs_review": false, "reference_text_review_reason": null, "source_dialogue_index": 11}
